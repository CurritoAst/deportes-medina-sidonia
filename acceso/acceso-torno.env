# ==========================================================================
# Configuración del servicio de acceso del torno.
# Se instala en /etc/acceso-torno.env. Tras editar, aplica los cambios con:
#     sudo systemctl restart acceso-torno
# ==========================================================================

# --- Web de gestión (tu despliegue en Render) ---
MSD_WEB=https://deportes-medina-sidonia.onrender.com

# --- Lectores del torno (convertidor HF5122) ---
# El HF5122 está en su red propia con la Pi (10.10.100.x), NO en la del router.
# Comprobado en el pabellón: los lectores se alcanzan por 10.10.100.254.
MSD_HOST_ENTRADA=10.10.100.254
MSD_HOST_SALIDA=10.10.100.254
MSD_PUERTO_ENTRADA=8899
MSD_PUERTO_SALIDA=9999

# --- Relé de apertura (VALORES QUE FUNCIONARON EN EL PABELLÓN) ---
# Backend GPIO: pinctrl en Pi OS Trixie (el 'auto' no lo detectó; forzar pinctrl).
MSD_GPIO=pinctrl
# Numeración de los pines: bcm | board (pin físico del header)
MSD_GPIO_NUM=bcm
# Polaridad: 1 = activo-bajo (placa de relé activo-bajo, confirmado)
MSD_RELE_ACTIVO_BAJO=1
# Pines calibrados in situ: ENTRADA=GPIO19, SALIDA=GPIO20. El GPIO26 NO hace nada
# en este torno. (Si cambias de torno, recalibra con buscar-pines.sh/test-rele.sh.)
MSD_PIN_ENTRADA=19
MSD_PIN_SALIDA=20
# LEDs (opcionales): descomenta y pon los pines
#MSD_PIN_LED_VERDE=21
#MSD_PIN_LED_ROJO=16
MSD_PULSO_MS=600

# --- Arranque prudente (ACTIVADO por defecto) ---
# SOLO-ESCUCHA: registra los pases en el journal pero NO abre. Así el primer
# arranque es seguro y confirmas la lectura sin riesgo. Cuando esté todo
# comprobado, pasa a apertura real con:  sudo bash acceso/ir-en-vivo.sh
MSD_SOLO_ESCUCHA=1
