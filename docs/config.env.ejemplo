# ==========================================================================
# Configuración por FICHERO para Plesk (alternativa al panel de variables).
# Copia este fichero a:   /var/www/vhosts/<dominio>/msd-data/config.env
# (la carpeta msd-data es la de MSD_DATA_DIR: FUERA de httpdocs, no se sirve por web)
# y edítalo con el File Manager. Después: Node.js → Restart App.
#
# Las variables que YA estén puestas en el panel de Plesk mandan; este fichero
# solo rellena las que falten. Útil porque el panel de Plesk BORRA filas con
# valor "0" al pulsar OK (por eso MSD_REGISTRO_ABIERTO=0 nunca llegaba).
# Solo se leen nombres que empiecen por MSD_. Líneas con # se ignoran.
# ==========================================================================

# --- Registro público: 0 = cerrado (solo el admin crea cuentas) · 1 = abierto ---
MSD_REGISTRO_ABIERTO=0

# --- URL pública (enlaces de los correos). Sin barra final. ---
MSD_URL_PUBLICA=https://cool-matsumoto.87-106-229-29.plesk.page

# --- Primer administrador (SOLO se usa si no existe ningún admin; después bórralo) ---
MSD_BOOTSTRAP_ADMIN_EMAIL=tu-correo@ejemplo.es
#MSD_BOOTSTRAP_ADMIN_CLAVE=ponla-en-el-panel-mejor-o-aqui-min-12-caracteres
#MSD_BOOTSTRAP_ADMIN_NOMBRE=Administración Deportes

# --- Correo saliente (buzón creado en Plesk → Mail). Sin MSD_SMTP_HOST no se envían correos. ---
#MSD_SMTP_HOST=mail.tu-servidor.es
#MSD_SMTP_PORT=587
#MSD_SMTP_USER=no-reply@tu-dominio.es
#MSD_SMTP_PASS=contraseña-del-buzon
#MSD_SMTP_DE=Deportes Medina Sidonia <no-reply@tu-dominio.es>

# --- Base de datos (si ya están en el panel, no hace falta repetirlas) ---
#MSD_DB_HOST=localhost
#MSD_DB_PORT=3306
#MSD_DB_NAME=deportes
#MSD_DB_USER=Pabellon
#MSD_DB_PASSWORD=...

# --- Torno (ya está en el panel) ---
#MSD_TOKEN_TORNO=torno-pabellon:<64 hex>
